From 1ab17cca4dfdd02474059f3836b5c4df436616bd Mon Sep 17 00:00:00 2001
From: Nikola Yotov <nikolayotov@protonmail.com>
Date: Wed, 23 Sep 2026 14:34:38 +0300
Subject: [PATCH 1/2] Use content mode switch for new displays on Android 17

On Android 17, create the virtual display with
VIRTUAL_DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH instead of OWN_CONTENT_ONLY
and SHOULD_SHOW_SYSTEM_DECORATIONS (Android ignores the flag in combination
with either). The display then gets system decorations in extended mode and
is eligible for desktop windowing, so the taskbar can launch apps into desks.

If the system drops the flag, recreate the display with the regular flags,
because without OWN_CONTENT_ONLY it would mirror the main display.

Only applies when system decorations are enabled (the default).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../scrcpy/video/NewDisplayCapture.java       | 31 +++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/server/src/main/java/com/genymobile/scrcpy/video/NewDisplayCapture.java b/server/src/main/java/com/genymobile/scrcpy/video/NewDisplayCapture.java
index 5ed4c73..5ea9c8f 100644
--- a/server/src/main/java/com/genymobile/scrcpy/video/NewDisplayCapture.java
+++ b/server/src/main/java/com/genymobile/scrcpy/video/NewDisplayCapture.java
@@ -41,6 +41,12 @@ public class NewDisplayCapture extends SurfaceCapture {
     private static final int VIRTUAL_DISPLAY_FLAG_TOUCH_FEEDBACK_DISABLED = 1 << 13;
     private static final int VIRTUAL_DISPLAY_FLAG_OWN_FOCUS = 1 << 14;
     private static final int VIRTUAL_DISPLAY_FLAG_DEVICE_DISPLAY_GROUP = 1 << 15;
+    private static final int VIRTUAL_DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH = 1 << 17;
+
+    // Internal field copied from android.view.Display
+    private static final int DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH = 1 << 15;
+
+    private static final int API_37_ANDROID_17 = 37;
 
     private final VirtualDisplayListener vdListener;
     private final NewDisplay newDisplay;
@@ -231,8 +237,29 @@ public class NewDisplayCapture extends SurfaceCapture {
                             | VIRTUAL_DISPLAY_FLAG_DEVICE_DISPLAY_GROUP;
                 }
             }
-            VirtualDisplay vd = ServiceManager.getDisplayManager()
-                    .createNewVirtualDisplay("scrcpy", displaySize.getWidth(), displaySize.getHeight(), dpi, surface, flags);
+            VirtualDisplay vd = null;
+            if (vdSystemDecorations && Build.VERSION.SDK_INT >= API_37_ANDROID_17) {
+                // A display that can switch content mode gets system decorations in extended mode and is eligible for
+                // desktop windowing. Android ignores the flag when combined with OWN_CONTENT_ONLY or
+                // SHOULD_SHOW_SYSTEM_DECORATIONS.
+                int desktopFlags = (flags & ~(VIRTUAL_DISPLAY_FLAG_OWN_CONTENT_ONLY | VIRTUAL_DISPLAY_FLAG_SHOULD_SHOW_SYSTEM_DECORATIONS))
+                        | VIRTUAL_DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH;
+                vd = ServiceManager.getDisplayManager()
+                        .createNewVirtualDisplay("scrcpy", displaySize.getWidth(), displaySize.getHeight(), dpi, surface, desktopFlags);
+                if ((vd.getDisplay().getFlags() & DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH) != 0) {
+                    Ln.i("New display allows content mode switch (desktop windowing)");
+                } else {
+                    // Dropped by the system (feature disabled on this build): without OWN_CONTENT_ONLY the display would
+                    // mirror the main display, so recreate it with the regular flags
+                    Ln.w("Content mode switch not supported, using a regular virtual display");
+                    vd.release();
+                    vd = null;
+                }
+            }
+            if (vd == null) {
+                vd = ServiceManager.getDisplayManager()
+                        .createNewVirtualDisplay("scrcpy", displaySize.getWidth(), displaySize.getHeight(), dpi, surface, flags);
+            }
             setCurrentVirtualDisplay(vd); // used for client resize
             int virtualDisplayId = vd.getDisplay().getDisplayId();
             Ln.i("New display: " + displaySize.getWidth() + "x" + displaySize.getHeight() + "/" + dpi + " (id=" + virtualDisplayId + ")");
-- 
